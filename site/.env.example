# Переменные окружения сайта. Только серверные — ничего с префиксом NEXT_PUBLIC_,
# иначе значение уедет в браузер. На хостинге задаются в панели проекта,
# после изменения контейнер нужно пересобрать или перезапустить.
#
# Проверить, что всё подхватилось: GET /api/lead → {"bitrix":"configured",...}

# Bitrix24 — основной приёмник заявок (crm.lead.add).
# Полный URL входящего вебхука, БЕЗ имени метода на конце.
BITRIX24_WEBHOOK_URL=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

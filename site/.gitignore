# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# originals of catalog photos: heavy, not needed for deploy.
# Web versions (public/media/catalog) and the manifest ARE committed.
photos-src/**
!photos-src/README.md
# Папки нужно разыменовать явно: git не заходит внутрь исключённой директории.
!photos-src/*/
!photos-src/*/alt.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Шаблон без значений — он и должен быть в репозитории.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

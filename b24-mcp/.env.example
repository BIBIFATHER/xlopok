# =============================================================================
# Canvas Lab — безопасный MCP-шлюз к Битрикс24
# Скопируйте в .env и заполните. .env в git не попадает.
# =============================================================================

# --- Bitrix24 inbound webhook -------------------------------------------------
# Базовый URL входящего вебхука, БЕЗ имени метода в конце.
# Формат: https://<portal>.bitrix24.ru/rest/<user_id>/<secret>/
# Не коммитить. Не логировать. Не передавать агентам.
BITRIX24_WEBHOOK_URL=

# --- Аутентификация MCP -------------------------------------------------------
# Базовый/админский токен. Генерация: openssl rand -hex 32
MCP_AUTH_TOKEN=

# Отдельный токен на каждого агента — иначе audit log и A/B-тест не различают,
# кто именно выполнил действие.
CLAUDE_MCP_TOKEN=
CODEX_MCP_TOKEN=
ADMIN_MCP_TOKEN=

# Идентичность локально запущенного stdio-процесса:
# claude_sales_agent | codex_sales_agent | admin
AGENT_ID=admin

# --- Предохранители -----------------------------------------------------------
# Write-инструменты НЕ регистрируются, пока значение не равно строго "true".
WRITE_ENABLED=false

# error | warn | info | debug
LOG_LEVEL=info

# --- Транспорт ----------------------------------------------------------------
# stdio — локальный запуск из Claude Code / Codex; http — размещённый шлюз.
TRANSPORT=stdio
PORT=8787

# --- Лимиты -------------------------------------------------------------------
# Максимум записей в ответе любого поискового инструмента.
MAX_PAGE_SIZE=50
# Лимит портала Битрикс24 — 2 запроса в секунду.
RATE_LIMIT_RPS=2
REQUEST_TIMEOUT_MS=15000

# Диалект tasks.task.list: legacy (классический вебхук) | v3 (REST v3 endpoint).
# По умолчанию legacy. Переключать на v3 только после live-проверки конкретного
# портала (npm run validate:live) — см. docs/LIVE_READONLY_VALIDATION.md.
TASKS_API_MODE=legacy

# --- Распределение работы между агентами --------------------------------------
# round_robin | performance_based | specialization_based
ROUTING_MODE=round_robin
# performance_based не включается, пока у каждого агента меньше этого числа
# завершённых назначений.
ROUTING_MIN_SAMPLE=50
# Через сколько минут зависшая блокировка снимается автоматически.
ASSIGNMENT_LOCK_MINUTES=60
# После этого числа передач между агентами задача уходит в HUMAN_REVIEW.
MAX_TRANSFERS=2
# Каталог локального состояния (назначения, метрики, идемпотентность, DLQ).
DATA_DIR=data
# A/B-тест: жёсткая привязка компании к одному агенту (без пересечений).
AB_TEST_ENABLED=false

# --- Пользовательские поля Canvas Lab -----------------------------------------
# JSON: доменное поле -> реальный код UF_CRM_* вашего портала.
# Оставьте пустым, пока поля не созданы. Коды НЕ выдумывать — взять из
# crm.item.fields после ручного создания полей в Битрикс24.
# Пример: FIELD_MAP_COMPANY={"segment":"UF_CRM_1700000001"}
FIELD_MAP_COMPANY=
FIELD_MAP_DEAL=
